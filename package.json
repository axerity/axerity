{
	"name": "@axerity/cli",
	"version": "0.2.2",
	"description": "A documentation site generator built with Svelte.",
	"type": "module",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"author": "aelpxy",
	"homepage": "https://axerity.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/axerity/axerity.git"
	},
	"bugs": {
		"url": "https://github.com/axerity/axerity/issues"
	},
	"keywords": [
		"documentation",
		"docs",
		"static-site-generator",
		"ssg",
		"sveltekit",
		"svelte",
		"markdown",
		"mdsvex",
		"openapi"
	],
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.3.0",
	"bin": {
		"axerity": "./bin/axerity.js"
	},
	"files": [
		"bin",
		"dist",
		"runtime",
		"axerity.default.json",
		"axerity.schema.json",
		"README.md"
	],
	"scripts": {
		"axerity": "node ./bin/axerity.js",
		"postversion": "git push --follow-tags",
		"prepare-engine": "node scripts/prepare-engine.mjs",
		"build:openapi": "vite build --config vite.openapi.config.ts",
		"build:engine": "vite build && pnpm build:openapi",
		"predev": "node scripts/prepare-engine.mjs && vite build && pnpm build:openapi",
		"dev": "node ./bin/axerity.js dev",
		"prebuild": "node scripts/prepare-engine.mjs && vite build && pnpm build:openapi",
		"build": "node ./bin/axerity.js build",
		"preview": "node ./bin/axerity.js preview",
		"prepublishOnly": "node scripts/prepare-engine.mjs && vite build && pnpm build:openapi",
		"prepare": "node scripts/prepare-engine.mjs && (svelte-kit sync || echo '')",
		"check": "node scripts/prepare-engine.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore && eslint .",
		"format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.2.9",
		"@fontsource-variable/geist-mono": "^5.2.8",
		"@lucide/svelte": "^1.17.0",
		"@orama/orama": "^3.1.18",
		"@resvg/resvg-js": "^2.6.2",
		"@shikijs/twoslash": "^4.1.0",
		"@sveltejs/kit": "^2.61.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"acorn": "^8.16.0",
		"chokidar": "^5.0.0",
		"lucide": "^1.17.0",
		"mdast-util-mdx-jsx": "^3.2.0",
		"mermaid": "^11.15.0",
		"micromark-extension-mdx-jsx": "^3.0.2",
		"rehype-slug": "^6.0.0",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"satori": "^0.26.0",
		"shiki": "^4.1.0",
		"svelte": "^5.56.0",
		"tailwindcss": "^4.3.0",
		"twoslash": "^0.3.8",
		"typescript": "^6.0.3",
		"unified": "^11.0.5",
		"vite": "^8.0.14",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@types/hast": "^3.0.4",
		"@types/mdast": "^4.0.4",
		"@types/node": "^25.9.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"github-slugger": "^2.0.0",
		"globals": "^17.6.0",
		"mdast-util-to-hast": "^13.2.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.0.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"remark-smartypants": "^3.0.2",
		"svelte-check": "^4.4.8",
		"typescript-eslint": "^8.60.0"
	}
}
