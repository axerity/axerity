{
	"name": "@axerity/cli",
	"version": "0.1.1",
	"description": "A documentation site generator built with Svelte.",
	"type": "module",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"author": "aelpxy",
	"homepage": "https://axerity.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/axerity/axerity.git"
	},
	"bugs": {
		"url": "https://github.com/axerity/axerity/issues"
	},
	"keywords": [
		"documentation",
		"docs",
		"static-site-generator",
		"ssg",
		"sveltekit",
		"svelte",
		"markdown",
		"mdsvex",
		"openapi"
	],
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.3.0",
	"bin": {
		"axerity": "./bin/axerity.js"
	},
	"files": [
		"bin",
		"scripts",
		"src",
		"static",
		"svelte.config.js",
		"vite.config.ts",
		"mdsvex.config.js",
		"tsconfig.json",
		"axerity.default.json",
		"axerity.schema.json",
		"README.md"
	],
	"scripts": {
		"axerity": "node ./bin/axerity.js",
		"postversion": "git push --follow-tags",
		"prepare-engine": "node scripts/prepare-engine.mjs",
		"predev": "node scripts/prepare-engine.mjs",
		"dev": "vite dev",
		"prebuild": "node scripts/prepare-engine.mjs",
		"build": "vite build",
		"prepreview": "node scripts/prepare-engine.mjs",
		"preview": "vite preview",
		"prepare": "node scripts/prepare-engine.mjs && (svelte-kit sync || echo '')",
		"check": "node scripts/prepare-engine.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore && eslint .",
		"format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.2.9",
		"@fontsource-variable/geist-mono": "^5.2.8",
		"@lucide/svelte": "^1.17.0",
		"@orama/orama": "^3.1.18",
		"@resvg/resvg-js": "^2.6.2",
		"@shikijs/twoslash": "^4.1.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.61.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"mdsvex": "^0.12.7",
		"mermaid": "^11.15.0",
		"rehype-slug": "^6.0.0",
		"satori": "^0.26.0",
		"shiki": "^4.1.0",
		"svelte": "^5.56.0",
		"tailwindcss": "^4.3.0",
		"twoslash": "^0.3.8",
		"typescript": "^6.0.3",
		"vite": "^8.0.14",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@types/node": "^25.9.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.0.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte-check": "^4.4.8",
		"typescript-eslint": "^8.60.0"
	}
}
