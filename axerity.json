{
	"$schema": "./axerity.schema.json",
	"name": "Axerity",
	"description": "A documentation site generator built with Svelte.",
	"url": "https://axerity.com",
	"github": "https://github.com/axerity",
	"editLink": "https://github.com/axerity/axerity/edit/main/src/content/docs",
	"og": {
		"enabled": true,
		"background": "#0a0a0a",
		"foreground": "#fafafa",
		"muted": "#a1a1a1",
		"accent": "#fafafa"
	},
	"logo": {
		"light": "/favicon-light.svg",
		"dark": "/favicon-dark.svg",
		"alt": "Axerity",
		"href": "/"
	},
	"layout": "flat",
	"theme": "neutral",
	"sidebar": {
		"variant": "card"
	},
	"versions": [
		{
			"label": "v1.0-preview",
			"href": "/"
		}
	],
	"dropdowns": [
		{
			"label": "Guides",
			"icon": "book-open",
			"href": "/",
			"match": "/",
			"tabs": [
				{
					"title": "Documentation",
					"href": "/",
					"match": "/",
					"icon": "book-open"
				},
				{
					"title": "Components",
					"href": "/components/callout",
					"match": "/components",
					"icon": "blocks"
				}
			]
		},
		{
			"label": "API Reference",
			"icon": "code",
			"href": "/api/pet/pet-object",
			"match": "/api",
			"tabs": [
				{
					"title": "Pet",
					"href": "/api/pet/pet-object",
					"match": "/api/pet",
					"icon": "paw-print"
				},
				{
					"title": "Store",
					"href": "/api/store/order-object",
					"match": "/api/store",
					"icon": "shopping-cart"
				},
				{
					"title": "User",
					"href": "/api/user/user-object",
					"match": "/api/user",
					"icon": "user"
				}
			]
		},
		{
			"label": "Petstore API",
			"icon": "paw-print",
			"href": "/petstore-api/pet/addpet",
			"match": "/petstore-api",
			"tabs": [
				{
					"title": "Pet",
					"href": "/petstore-api/pet/addpet",
					"match": "/petstore-api/pet",
					"icon": "paw-print"
				},
				{
					"title": "Store",
					"href": "/petstore-api/store/getinventory",
					"match": "/petstore-api/store",
					"icon": "shopping-cart"
				},
				{
					"title": "User",
					"href": "/petstore-api/user/createuser",
					"match": "/petstore-api/user",
					"icon": "user"
				},
				{
					"title": "Schemas",
					"href": "/petstore-api/schemas/order",
					"match": "/petstore-api/schemas",
					"icon": "box"
				}
			]
		}
	],
	"sidebarLinks": [
		{
			"title": "Issues",
			"href": "https://github.com/axerity/axerity/issues"
		}
	],
	"openapi": [
		{
			"spec": "petstore-openapi.json",
			"output": "petstore-api",
			"title": "Petstore API"
		}
	],
	"topNav": [
		{
			"title": "Docs",
			"href": "/"
		},
		{
			"title": "Components",
			"href": "/components/callout"
		}
	]
}
